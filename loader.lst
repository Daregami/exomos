   216                                  %include "gdt_table.asm"
     1                              <1> ; GDT таблица
     2                              <1> align 16
     3                              <1> gdt_start:
     4                              <1>     ; Нулевой дескриптор
     5 000001B0 00000000            <1>     dd 0x00000000
     6 000001B4 00000000            <1>     dd 0x00000000
     7                              <1> 
     8                              <1>     ; Дескриптор сегмента кода ядра
     9 000001B8 FFFF                <1>     dw 0xFFFF ; Лимиты на 4гб с учетом включенной гранулярности, страничной адресации по 4кб
    10 000001BA 0000                <1>     dw 0x0000 ; выбор базы на 20 бит, но так как адресация страницная, охватываются все 4гб
    11 000001BC 00                  <1>     db 0x00
    12 000001BD 9A                  <1>     db 0x9A ; 10011010b
    13                              <1>     ; 1 - сегмент находится в памяти
    14                              <1>     ; 00 - пространство ядра, при 11 было бы Ring3
    15                              <1>     ; 1 - сегмент кода или данных
    16                              <1>     ; 1 - можно выполнять код
    17                              <1>     ; 0 - код может вызываться только из своего Ring0
    18                              <1>     ; 1 - запись разрешена
    19                              <1>     ; 0 - процессор устновит его в 1 при обращении к сегменту
    20                              <1>       
    21 000001BE CF                  <1>     db 0xCF
    22                              <1>     ; 1 - гранулярность для того чтобы видеть больше 1мб, лимит в страницах
    23                              <1>     ; 1 - 32-битный сегмент
    24                              <1>     ; младшие 4 бита лимита, для 4гб это 1111
    25                              <1> 
    26 000001BF 00                  <1>     db 0x00 ; база сегмента
    27                              <1> 
    28                              <1>     ; Дескриптор сегмента данных ядра
    29 000001C0 FFFF                <1>     dw 0xFFFF
    30 000001C2 0000                <1>     dw 0x0000
    31 000001C4 00                  <1>     db 0x00
    32 000001C5 92                  <1>     db 0x92
    33 000001C6 CF                  <1>     db 0xCF
    34 000001C7 00                  <1>     db 0x00
    35                              <1> gdt_end:
    36                              <1> 
    37                              <1> align 4
    38                              <1> gdt_descriptor:
    39 000001C8 1700                <1>     dw gdt_end - gdt_start - 1 ; вычитается 1 для возможности сохранять полноразмерные структуры (напр. 64кб)
    40 000001CA [B0010000]          <1>     dd gdt_start
   217                                  
   218 000001CE 00<rep 7E32h>           times 32768-($-$$) db 0

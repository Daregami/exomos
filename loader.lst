     1                                  [BITS 16]
     2                                  org 0x7E00
     3                                  
     4 00000000 EB65                    jmp _load_start
     5                                  
     6                                  ; Главный каталог (1024 записи)
     7                                  PAGE_DIRECTORY      equ 0x10000 ; 4 КБ: 0x10000–0x10FFF
     8                                  ; Таблица для идентичного маппинга адресов
     9                                  PAGE_TABLE_IDENTITY equ 0x11000 ; 4 КБ: 0x11000–0x11FFF
    10                                  ; Таблица для старших адресов ядра
    11                                  PAGE_TABLE_HIGH     equ 0x12000 ; 4 КБ: 0x12000–0x12FFF
    12                                  
    13                                  %include "print.asm"
     1                              <1> ; Функция печати строки
     2                              <1> print_str:
     3                              <1> .loop:
     4 00000002 AC                  <1>     lodsb ; считать символ в регистр al
     5 00000003 08C0                <1>     or al,al ; если не ноль продолжаем цикл
     6 00000005 7406                <1>     jz .done
     7 00000007 B40E                <1>     mov ah,0x0E ; функция режима телетайпа
     8 00000009 CD10                <1>     int 0x10
     9 0000000B EBF5                <1>     jmp .loop
    10                              <1> 
    11                              <1> .done:
    12 0000000D C3                  <1>     ret

    25 0000001B E8E4FF                      call print_str
    26                                  .halt:
    27 0000001E FA                          cli
    28 0000001F F4                          hlt
    29 00000020 EBFC                        jmp .halt
    30                                  
    31                                  elf_error:
    32 00000022 BE[5F00]                    mov si, error_elf
    33 00000025 E8DAFF                      call print_str
    34                                  .halt:
    35 00000028 FA                          cli
    36 00000029 F4                          hlt
    37 0000002A EBFC                        jmp .halt
    38                                  
    39 0000002C 4C6F6164206B65726E-     msg_kload db 'Load kernel... ',0
    39 00000035 656C2E2E2E2000     
    40 0000003C 4469736B206572726F-     error_disk db 'Disk error... ',0
    40 00000045 722E2E2E2000       
    41 0000004B 42696F73206572726F-     error_bios db 'Bios error... ',0
    41 00000054 722E2E2E2000       
    42 0000005A 4F4B0D0A00              msg_ok db 'OK',0x0D,0x0A,0
    43 0000005F 4E6F7420454C4600        error_elf db 'Not ELF',0
    44                                  
    45                                  _load_start:
    46 00000067 BE[2C00]                    mov si,msg_kload
    47 0000006A E895FF                      call print_str
    48                                  
    49                                  copy_kernel:
    50 0000006D BD4000                      mov bp,64 ; количество итераций для загрузки ядра - 2мб / 32кб = 64
    51                                  
    52                                  .loop:
    53 00000070 55                          push bp
    54 00000071 31C0                        xor ax,ax
    55 00000073 8ED8                        mov ds,ax
    56                                  
    57                                      ; Если bios выдал нулевой диск, меняем на стандартный
    58 00000075 88D0                        mov al,dl
    59 00000077 84C0                        test al,al
    60 00000079 7502                        jnz .break
    61 0000007B B280                        mov dl, 0x80 ; Захардкоженный номер диска
    62                                      .break:
    63                                  
    64                                      ; Записываем часть ядра во временный буфер 32кб на 64 сектора
    65 0000007D B442                        mov ah,0x42
    66 0000007F BE[6C01]                    mov si,disk_dap
    67 00000082 CD13                        int 0x13
    68                                  
    69 00000084 7288                        jc disk_error
    70                                  
    71                                      ; Сразу из бефера парсим ELF
    72                                      ;cmp [0x20000], 0x7F ; проверяем магическое число
    73 00000086 EB9A                        jmp elf_error
    74                                  
    75                                      ; Копирование из буфера в верхние адреса
    76 00000088 B90040                      mov cx,0x4000 ; счетчик пересылаемых 16-битовых слов
    77 0000008B BE[8001]                    mov si,bios_gdt
    78 0000008E 31C0                        xor ax,ax
    79 00000090 8EC0                        mov es,ax
    80 00000092 B80087                      mov ax,0x8700 ; функция переноса блока
    81 00000095 CD15                        int 0x15
    82                                  
    83 00000097 0F827DFF                    jc bios_error
    84                                  
    85 0000009B 668306[7401]40              add dword [disk_dap + 8],64 ; 64 * 512 = 32кб
    86 000000A1 8106[9A01]0080              add word [bios_gdt + 26],0x8000
    87 000000A7 8016[9C01]00                adc byte [bios_gdt + 28],0 ; если переполнили разряд, прибавляем
    88 000000AC 5D                          pop bp ; достаем счетчик
    89 000000AD 4D                          dec bp
    90 000000AE 75C0                        jnz .loop ; считали нужное количество блоков - выходим
    91                                  
    92 000000B0 BE[5A00]                    mov si,msg_ok
    93 000000B3 E84CFF                      call print_str
    94                                  
    95                                      ; Открываем доступ к памяти объемом больше 1мб
    96                                  %include "a20_enable.asm"
     1                              <1> enable_a20:
     2 000000B6 B80124              <1>     mov ax,0x2401 ; функция включения a20
     3 000000B9 CD15                <1>     int 0x15
     4                              <1> 
     5 000000BB 7209                <1>     jc .bios_error ; если флаг переноса установлен - ошибка
     6                              <1> 
     7                              <1>     ; Проверка статуса
     8 000000BD B80224              <1>     mov ax,0x2402
     9 000000C0 CD15                <1>     int 0x15
    10 000000C2 3C01                <1>     cmp al,1
    11 000000C4 7406                <1>     je .done
    12                              <1> 
    13                              <1> .bios_error:
    14                              <1>     ; Страхуемся через быстрый порт включения линии a20
    15 000000C6 E492                <1>     in al,0x92
    16 000000C8 0C02                <1>     or al,2 ; устанавливаем второй бит
    17 000000CA E692                <1>     out 0x92,al ; возвращаем через порт
    18                              <1> 
    19                              <1> .done:
    97                                  
    98                                      ; Переходим в Protect Mode
    99 000000CC FA                          cli ; намертво блокируем прерывания из реального режима
   100 000000CD 0F0116[C801]                lgdt [gdt_descriptor] ; загружаем указатель на GDT
   101                                  
   102                                      ; Включаем бит PE
   103 000000D2 0F20C0                      mov eax,cr0
   104 000000D5 6683C801                    or eax,1
   105 000000D9 0F22C0                      mov cr0,eax ; в протект моде
   106                                  
   107 000000DC EA[E100]0800                jmp 0x08:pm_entry ; обязательный дальний прыжок дабы сбросить конвейер из 16 битных инструкций
   108                                                        ; а также применение нового сегмента кода, что по факту просто смещение от GDT структуры
   109                                  
   110                                  [BITS 32]
   111                                  pm_entry:
   112                                      ; Настраиваем сегментные регистры на селектор данных
   113 000000E1 66B81000                    mov ax,0x10
   114 000000E5 8ED8                        mov ds,ax
   115 000000E7 8EC0                        mov es,ax
   116 000000E9 8EE0                        mov fs,ax
   117 000000EB 8EE8                        mov gs,ax
   118 000000ED 8ED0                        mov ss,ax
   119                                  
   120                                      ; Обнуляем область под таблицы (3 * 4096 = 12288 байт = 3072 двойных слова)
   121 000000EF BF00000100                  mov edi, PAGE_DIRECTORY
   122 000000F4 31C0                        xor eax, eax
   123 000000F6 B9000C0000                  mov ecx, 3072
   124 000000FB F3AB                        rep stosd
   125                                  
   126                                      ; Заполняем идентичный маппинг, чтобы после смены режима
   127                                      ; процессор смог считать сдедующие инструкции из памяти
   128                                      ; маппим первые 4 МБ (1024 страницы по 4 КБ)
   129 000000FD BF00100100                  mov edi, PAGE_TABLE_IDENTITY
   130 00000102 B803000000                  mov eax, 0x00000003  ; физ. адрес 0, биты P + R/W (существует в памяти и можно писать и читать)
   131 00000107 B900040000                  mov ecx, 1024
   132                                  .fill_identity:
   133 0000010C 8907                        mov [edi], eax
   134 0000010E 0500100000                  add eax, 0x1000
   135 00000113 83C704                      add edi, 4
   136 00000116 49                          dec ecx
   137 00000117 75F3                        jnz .fill_identity
   138                                  
   139                                      ; Маппим 0xC0000000+ по физическим адресам 0x00000000+ (первые 4 МБ)
   140 00000119 BF00200100                  mov edi, PAGE_TABLE_HIGH
   141 0000011E B803000000                  mov eax, 0x00000003
   142 00000123 B900040000                  mov ecx, 1024
   143                                  .fill_high:
   144 00000128 8907                        mov [edi], eax
   145 0000012A 0500100000                  add eax, 0x1000
   146 0000012F 83C704                      add edi, 4
   147 00000132 49                          dec ecx
   148 00000133 75F3                        jnz .fill_high
   149                                  
   150                                      ; Заполняем каталог страниц
   151 00000135 C70500000100031001-         mov dword [PAGE_DIRECTORY + 0*4], PAGE_TABLE_IDENTITY + 0x03
   151 0000013E 00                 
   152 0000013F C705000C0100032001-         mov dword [PAGE_DIRECTORY + 768*4], PAGE_TABLE_HIGH + 0x03
   152 00000148 00                 
   153                                  
   154                                      ; Загружаем каталов в регистр CR3
   155 00000149 B800000100                  mov eax, PAGE_DIRECTORY
   156 0000014E 0F22D8                      mov cr3, eax
   157                                  
   158                                      ; Включаем пагинацию (31 бит PG в CR0)
   159 00000151 0F20C0                      mov eax, cr0
   160 00000154 0D00000080                  or eax, 0x80000000
   161 00000159 0F22C0                      mov cr0, eax
   162                                  
   163                                      ; Прыжок в ядро по виртуальному адресу higher-half
   164 0000015C BC000009C0                  mov esp, 0xC0090000           ; стек тоже через higher-half
   165 00000161 EA000010C00800              jmp 0x08:0xC0100000           ; ядро по виртуальному адресу
   166                                  
   167                                      ; Настройка стека чуть ниже ядра
   168                                      ; mov esp,0x90000
   169                                  
   170                                      ; Так как сегменты настроены в виде Flat Model (плоской модели) с базовым адресом 0
   171                                      ; то физический адрес 0x100000 доступен просто по указателю
   172                                      ; mov eax,0x100000
   173                                      ; jmp eax ; прыжок в ядро
   174                                  
   175                                  stop_system:
   176 00000168 FA                          cli
   177 00000169 F4                          hlt
   178 0000016A EBFC                        jmp stop_system
   179                                  
   180                                  align 4
   181                                  disk_dap:
   182 0000016C 10                          db 0x10
   183 0000016D 00                          db 0
   184 0000016E 4000                        dw 64 ; читаем 64 сектора за раз в буфер
   185 00000170 0000                        dw 0x0000 ; Смещение буфера
   186 00000172 0020                        dw 0x2000 ; Сегмент буфера
   187                                  dap_lba:
   188 00000174 4100000000000000            dq 65
   189                                  
   190 0000017C 90<rep 4h>              align 8
   191                                  bios_gdt:
   192 00000180 0000000000000000            dq 0 ; нулевой дескриптор
   193 00000188 0000000000000000            dq 0 ; настраивается BIOS
   194                                  
   195                                      ; Источник данных данных из буфера
   196 00000190 FFFF                        dw 0xFFFF ; предел перемещаемого куска
   197 00000192 0000                        dw 0x0000 ; базовый адрес буфера
   198 00000194 02                          db 0x02 ; средний базовый адрес
   199 00000195 93                          db 0x93 ; права доступа чтение/запись
   200                                              ; находятся в памяти, данные, в Ring0
   201 00000196 00                          db 0x00
   202 00000197 00                          db 0x00
   203                                      
   204                                      ; Приемник данных данных из буфера
   205 00000198 FFFF                        dw 0xFFFF
   206 0000019A 0000                        dw 0x0000 ; базовый адрес расположения ядра
   207 0000019C 10                          db 0x10 ; средний базовый адрес
   208 0000019D 93                          db 0x93 ; права доступа чтение/запись
   209                                              ; находятся в памяти, данные, в Ring0
   210 0000019E 00                          db 0x00
   211 0000019F 00                          db 0x00
   212                                  
   213 000001A0 0000000000000000            dq 0
   214 000001A8 0000000000000000            dq 0

    16 0000000E BE[3C00]                    mov si,error_disk
    17 00000011 E8EEFF                      call print_str
    18                                  .halt:
    19 00000014 FA                          cli
    20 00000015 F4                          hlt
    21 00000016 EBFC                        jmp .halt
    22                                  
